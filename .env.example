# Database: SQLite file (works in AI Studio and locally, nothing to install)
DATABASE_URL="file:./dev.db"

# Session secret for the signed login cookie
SESSION_SECRET="novaworks-hack-26-Kq9xZ2mLp7Rt4vBw8Yc"

# Gemini key: AI Studio fills this in itself. Leave it as is.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OpenRouter key: paste your own key here (starts with sk-or-v1-)
OPENROUTER_API_KEY="PASTE_YOUR_KEY_HERE"

# Models, tried in order
OPENROUTER_MODELS="nvidia/nemotron-3-ultra-550b-a55b:free,nvidia/nemotron-3.5-lightning:free,openai/gpt-4o-mini"

# App URL: AI Studio fills this in itself. Leave it as is.
APP_URL="MY_APP_URL"