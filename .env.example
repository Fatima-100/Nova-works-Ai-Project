# DATABASE_URL: Local or remote SQL Server / SQLite connection string
DATABASE_URL="sqlserver://localhost:1433;database=novaworks;user=sa;password=Demo123!;trustServerCertificate=true;encrypt=true"

# SESSION_SECRET: Used by jose / JWT for HTTP-only signed session cookies
SESSION_SECRET="novaworks-super-secret-jwt-key-2026-infinity-hack"

# GEMINI_API_KEY: Injected by AI Studio runtime or user secrets
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENROUTER_API_KEY: Optional fallback OpenAI-compatible API key
OPENROUTER_API_KEY=""

# OPENROUTER_MODELS: Ordered comma-separated list of models for OpenRouter fallback
OPENROUTER_MODELS="google/gemini-2.0-flash-exp:free,meta-llama/llama-3.3-70b-instruct:free,anthropic/claude-3.5-haiku"

# APP_URL: The URL where this applet is hosted
