generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

// SQL Server in Prisma: no enums, no String[].
// Role is a String checked in code ("ADMIN" | "MANAGER" | "AGENT").
// Skills is stored as a JSON string array e.g. '["React","Node.js"]'.

model User {
  id              String    @id // PM01, DEV01, ADMIN
  name            String
  email           String    @unique
  passwordHash    String
  role            String    // "ADMIN" | "MANAGER" | "AGENT"
  specialization  String
  skills          String    // JSON text, e.g. '["React","Node.js"]'
  managedProjects Project[] @relation("Manager")
  tasks           Task[]
}

model Project {
  id          String   @id @default(cuid())
  name        String
  clientName  String
  description String
  managerId   String
  manager     User     @relation("Manager", fields: [managerId], references: [id])
  deadline    String   // YYYY-MM-DD
  createdAt   DateTime @default(now())
  tasks       Task[]
}

model Task {
  id             String  @id @default(cuid())
  projectId      String
  project        Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title          String
  description    String
  assigneeId     String
  assignee       User    @relation(fields: [assigneeId], references: [id])
  deadline       String  // YYYY-MM-DD
  estimatedHours Float
  status         String  @default("Pending") // "Pending" | "In Progress" | "Completed"
}
